{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.json",
    "eslint.config.mjs",
    ".prettierrc",
    ".prettierignore",
    ".env",
    ".env.example"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_APP_ENVIRONMENT",
        "VITE_API_URL",
        "EXPO_PUBLIC_APP_ENVIRONMENT",
        "EXPO_PUBLIC_API_URL"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
