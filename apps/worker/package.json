{
  "name": "@protege-mais/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/app.test.ts src/job-processor.test.ts",
    "test:redis": "APP_ENVIRONMENT=LOCAL REDIS_URL=redis://127.0.0.1:6379/0 tsx --test src/worker.integration.test.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "start": "node dist/apps/worker/src/index.js"
  },
  "dependencies": {
    "@protege-mais/config": "workspace:*",
    "@protege-mais/plugins": "workspace:*",
    "@protege-mais/use-cases": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
