{
  "name": "@protege-mais/manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc-alias -p tsconfig.json -f -fe .js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "start": "node dist/apps/manager_api/src/server.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@protege-mais/common": "workspace:*",
    "@protege-mais/config": "workspace:*",
    "@protege-mais/plugins": "workspace:*",
    "@protege-mais/schema": "workspace:*",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.1",
    "i18next": "^26.3.6",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
