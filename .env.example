# PostgreSQL
POSTGRES_DB=protege_mais
POSTGRES_USER=protege_mais
POSTGRES_PASSWORD=admin
DATABASE_URL=postgresql://protege_mais:admin@localhost:5432/protege_mais
DB_DATABASE_URL=postgresql://protege_mais:admin@db:5432/protege_mais?sslmode=disable
DB_ATLAS=postgresql://protege_mais:admin@atlas-db:5432/dev?sslmode=disable

# API
APP_ENVIRONMENT=LOCAL
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# MinIO / S3
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_BASE_URL=http://localhost:9002
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminadmin
S3_BUCKET=protege-mais
S3_REGION=us-east-1
