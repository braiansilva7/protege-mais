# Ambiente comum da Manager API e do Worker
APP_ENVIRONMENT=LOCAL
LOG_LEVEL=info

# PostgreSQL e Atlas locais
POSTGRES_DB=protege_mais
POSTGRES_USER=protege_mais
POSTGRES_PASSWORD=local-postgres-change-before-production
DATABASE_URL=postgresql://protege_mais:local-postgres-change-before-production@localhost:5432/protege_mais
DB_DATABASE_URL=postgresql://protege_mais:local-postgres-change-before-production@db:5432/protege_mais?search_path=public&sslmode=disable
DB_ATLAS=postgresql://protege_mais:local-postgres-change-before-production@atlas-db:5432/dev?search_path=public&sslmode=disable

# Manager API
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Web (valores públicos incorporados pelo Vite)
VITE_APP_ENVIRONMENT=LOCAL
VITE_API_URL=http://localhost:3000/api/v1

# Mobile (valores públicos incorporados pelo Expo)
EXPO_PUBLIC_APP_ENVIRONMENT=LOCAL
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Redis compartilhado pela Manager API e pelo Worker
REDIS_URL=redis://localhost:6379/0

# JWT e criptografia (capacidades para os tickets de segurança)
JWT_ACCESS_SECRET=local-only-jwt-access-change-before-production
JWT_REFRESH_SECRET=local-only-jwt-refresh-change-before-production
ENCRYPTION_KEY=local-only-encryption-key-change-before-production

# MinIO / S3
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=local-minio-access-change-before-production
S3_SECRET_KEY=local-minio-secret-change-before-production
S3_BUCKET=protege-mais
S3_REGION=us-east-1

# SMTP (a integração será implementada em ticket posterior)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local-user
SMTP_PASSWORD=local-only-smtp-change-before-production
SMTP_FROM=noreply@example.test
