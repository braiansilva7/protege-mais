    "./authentication": "./authentication/index.ts"
  },
  "dependencies": {
    "@protege-mais/common": "workspace:*",
    "@protege-mais/interfaces": "workspace:*",
    "argon2": "0.45.1",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.22.4"
  }
}
