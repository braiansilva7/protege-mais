{
  "name": "@protege-mais/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test authentication/*.test.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
