{
  "name": "@protege-mais/plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test database/database.test.ts error-handler/error-handler.test.ts i18next/i18next.test.ts logging/logging.test.ts queues/queues.test.ts readiness/readiness.test.ts redis/redis.test.ts",
    "test:database": "APP_ENVIRONMENT=LOCAL tsx --test database/accounts.integration.test.ts database/database.integration.test.ts",
    "test:redis": "APP_ENVIRONMENT=LOCAL REDIS_URL=redis://127.0.0.1:6379/0 tsx --test redis/redis.integration.test.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "exports": {
    ".": "./index.ts",
    "./database": "./database/index.ts",
    "./logging": "./logging/index.ts",
    "./queues": "./queues/index.ts",
    "./redis": "./redis/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.3",
    "@protege-mais/common": "workspace:*",
    "@protege-mais/models": "workspace:*",
    "@protege-mais/schema": "workspace:*",
    "bullmq": "6.3.0",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.1",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.6",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "redis": "6.2.1",
    "tslib": "2.8.1",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@protege-mais/config": "workspace:*",
    "@types/node": "^24.10.0",
    "tsx": "^4.22.4"
  }
}
